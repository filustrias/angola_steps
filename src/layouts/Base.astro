---
import '../styles/global.css';
import { paginasOrdenadas, rotulo, caminho, type Pagina } from '../navegacao';

interface Props {
  pagina: Pagina;
}

const NOME_SITE = 'Condições crónicas em Angola';
const { pagina } = Astro.props;
const paginas = await paginasOrdenadas();
const menu = paginas.filter((p) => p.data.ordem > 0);
const i = paginas.findIndex((p) => p.id === pagina.id);
const anterior = i > 0 ? paginas[i - 1] : undefined;
const seguinte = i < paginas.length - 1 ? paginas[i + 1] : undefined;
const titulo = pagina.data.ordem === 0 ? NOME_SITE : `${pagina.data.titulo} — ${NOME_SITE}`;
---
<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={pagina.data.resumo} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Aplica o tema guardado antes de desenhar a página (evita o piscar).
      try {
        var t = localStorage.getItem('tema');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="saltar" href="#conteudo">Saltar para o conteúdo</a>
    <header class="topo">
      <div class="largura">
        <a class="marca" href={caminho('/')}>{NOME_SITE}</a>
        <nav aria-label="Páginas do site">
          <ol class="menu">
            {menu.map((p) => (
              <li>
                <a
                  href={caminho(p.data.rota)}
                  aria-current={p.id === pagina.id ? 'page' : undefined}
                >
                  <span class="num" aria-hidden="true">{p.data.ordem}</span>
                  {rotulo(p)}
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <button type="button" class="tema" id="botao-tema" aria-label="Mudar para o tema escuro">
          <svg class="icone-lua" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          <svg class="icone-sol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <span class="tema-texto">Escuro</span>
        </button>
      </div>
    </header>

    <main id="conteudo" class="largura">
      <h1>{pagina.data.titulo}</h1>
      <slot />

      <nav class="anterior-seguinte" aria-label="Navegação entre páginas">
        {anterior ? (
          <a class="anterior" href={caminho(anterior.data.rota)} rel="prev">
            <span class="dir">Anterior</span>
            <span class="alvo">{rotulo(anterior)}</span>
          </a>
        ) : <span />}
        {seguinte ? (
          <a class="seguinte" href={caminho(seguinte.data.rota)} rel="next">
            <span class="dir">Seguinte</span>
            <span class="alvo">{rotulo(seguinte)}</span>
          </a>
        ) : <span />}
      </nav>
    </main>

    <footer class="rodape">
      <div class="largura">
        <p>{NOME_SITE}: ponto de situação para preparar um inquérito nacional do tipo STEPS.</p>
        <p>Os elementos marcados <span class="a-confirmar">[a confirmar]</span> ainda estão a ser verificados.</p>
        <p><a href="https://github.com/filustrias/angola_steps" target="_blank" rel="noopener">Código-fonte no GitHub</a></p>
      </div>
    </footer>

    <script>
      const raiz = document.documentElement;
      const botao = document.getElementById('botao-tema') as HTMLButtonElement;
      const escuroDoSistema = window.matchMedia('(prefers-color-scheme: dark)');

      const temaAtual = () =>
        raiz.dataset.theme ?? (escuroDoSistema.matches ? 'dark' : 'light');

      function atualizarBotao() {
        const escuro = temaAtual() === 'dark';
        botao.setAttribute('aria-label', escuro ? 'Mudar para o tema claro' : 'Mudar para o tema escuro');
        botao.querySelector('.tema-texto')!.textContent = escuro ? 'Claro' : 'Escuro';
      }

      botao.addEventListener('click', () => {
        const novo = temaAtual() === 'dark' ? 'light' : 'dark';
        raiz.dataset.theme = novo;
        try { localStorage.setItem('tema', novo); } catch {}
        atualizarBotao();
      });
      escuroDoSistema.addEventListener('change', atualizarBotao);
      atualizarBotao();
    </script>
  </body>
</html>
